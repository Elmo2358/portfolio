# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# Cron Job Secret for scheduled tasks
CRON_SECRET="change-this-to-a-random-string-in-production"

# CLIST API (Optional - for contest schedule)
# Get your API key from https://clist.by/
# CLIST_USERNAME="your-clist-username"
# CLIST_API_KEY="your-clist-api-key"

# Google Calendar API (Optional - for calendar integration)
# Quickstart: https://developers.google.com/workspace/calendar/quickstart
# GOOGLE_CALENDAR_ACCESS_TOKEN="your-access-token"

# OAuth Providers (Optional - for GitHub/Google login)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
