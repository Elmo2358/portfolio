generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  name                  String?
  image                 String?
  role                  String               @default("user")
  atCoderId             String?              @unique
  googleTasksEnabled    Boolean              @default(false)
  googleTasksTasklistId String?
  notionWikiEnabled     Boolean              @default(false)
  notionWikiDatabaseId  String?
  googleAccountId       String?
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiresAt  DateTime?
  notionAccessToken     String?
  claudeApiKey          String?
  claudeApiEnabled      Boolean              @default(false)
  uecPortalEnabled      Boolean              @default(false)
  uecPortalDataDir      String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  clistApiEnabled       Boolean              @default(false)
  clistApiKey           String?
  clistUsername         String?
  atCoderSubmissions    AtCoderSubmission[]
  atCoderUserProblems   AtCoderUserProblem[]
  books                 Book[]
  bucketListItems       BucketListItem[]
  codeReviews           CodeReview[]
  contestReminders      ContestReminder[]
  expenses              Expense[]
  games                 Game[]
  incomes               Income[]
  internships           Internship[]
  jobApplications       JobApplication[]
  learningPlans         LearningPlan[]
  learningTasks         LearningTask[]
  notificationLogs      NotificationLog[]
  projects              Project[]
  qaConversations       QaConversation[]
  qualifications        Qualification[]
  reminders             Reminder[]
  skills                Skill[]
  tasks                 Task[]
  teamExperiences       TeamExperience[]
  uecNotices            UecNotice[]
  uecScheduleEntries    UecScheduleEntry[]
  uecSyncLogs           UecSyncLog[]
  uecTimetableEntries   UecTimetableEntry[]
  timerSessions         TimerSession[]
  apg4bProgress         Apg4bUserProgress[]
}

model Qualification {
  id           String   @id @default(cuid())
  name         String
  score        String?
  date         DateTime
  description  String?
  category     String
  displayOrder Int
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Internship {
  id           String   @id @default(cuid())
  title        String
  company      String?
  period       String
  description  String?
  learned      String?
  displayOrder Int
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamExperience {
  id           String   @id @default(cuid())
  title        String
  organization String
  period       String
  description  String?
  learned      String?
  role         String?
  displayOrder Int
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(cuid())
  title        String
  description  String?
  technologies String
  url          String?
  githubUrl    String?
  imageUrl     String?
  displayOrder Int
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id           String   @id @default(cuid())
  name         String
  category     String
  level        Int
  description  String?
  displayOrder Int
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String
  priority     String
  dueDate      DateTime?
  completedAt  DateTime?
  googleTaskId String?
  notionUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Income {
  id          String   @id @default(cuid())
  source      String
  amount      Float
  date        DateTime
  description String?
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  item        String
  amount      Float
  date        DateTime
  category    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobApplication {
  id          String   @id @default(cuid())
  type        String   @default("本選考")
  company     String
  position    String?
  status      String
  appliedDate DateTime
  notes       String?
  notionUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id          String    @id @default(cuid())
  title       String
  genre       String?
  platform    String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  rating      Int?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Book {
  id          String    @id @default(cuid())
  title       String
  author      String?
  genre       String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  rating      Int?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BucketListItem {
  id          String    @id @default(cuid())
  title       String
  category    String
  description String?
  status      String
  targetDate  DateTime?
  completedAt DateTime?
  priority    Int
  notionUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AtCoderProblem {
  id             String               @id
  contestId      String
  title          String
  difficulty     Int?
  tags           String?
  url            String
  explanationUrl String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  submissions    AtCoderSubmission[]
  userProblems   AtCoderUserProblem[]
}

model AtCoderUserProblem {
  id            String         @id @default(cuid())
  userId        String
  problemId     String
  status        String         @default("unattempted")
  memo          String?
  lastAttempted DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  problem       AtCoderProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userRel       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, status])
}

model AtCoderSubmission {
  id            String         @id
  userId        String
  problemId     String
  language      String
  result        String
  executionTime Int?
  epochSecond   Int
  createdAt     DateTime       @default(now())
  problem       AtCoderProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userRel       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, epochSecond])
  @@index([problemId])
}

model ContestReminder {
  id          String   @id @default(cuid())
  userId      String
  contestId   String
  event       String
  resource    String
  start       String
  end         String
  href        String
  remind24h   Boolean  @default(true)
  remind1h    Boolean  @default(true)
  notified24h Boolean  @default(false)
  notified1h  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userRel     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@index([userId, start])
  @@index([userId, resource])
}

model Reminder {
  id               String    @id @default(cuid())
  userId           String
  targetEntityType String
  targetEntityId   String
  title            String
  description      String?
  remindAt         DateTime
  notifyMethod     String    @default("app")
  isNotified       Boolean   @default(false)
  notifiedAt       DateTime?
  calendarEventId  String?
  reminder24h      Boolean   @default(false)
  reminder1h       Boolean   @default(false)
  reminderCustom   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userRel          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, targetEntityType, targetEntityId])
  @@index([userId, remindAt])
  @@index([isNotified])
}

model NotificationLog {
  id         String    @id @default(cuid())
  userId     String
  reminderId String?
  type       String
  title      String
  message    String
  method     String
  sentAt     DateTime  @default(now())
  status     String    @default("sent")
  read       Boolean   @default(false)
  readAt     DateTime?
  userRel    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, sentAt])
  @@index([reminderId])
  @@index([userId, read])
}

model QaConversation {
  id        String   @id @default(cuid())
  userId    String
  problemId String?
  title     String
  messages  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userRel   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
  @@index([userId, updatedAt])
}

model EditorialCache {
  id            String   @id @default(cuid())
  problemId     String   @unique
  editorialText String
  summary       String?
  keyPoints     String?
  difficulty    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([problemId])
}

model HintCache {
  id        String   @id @default(cuid())
  problemId String
  hintLevel Int
  hintText  String
  createdAt DateTime @default(now())

  @@unique([problemId, hintLevel])
  @@index([problemId])
}

model CodeReview {
  id                   String   @id @default(cuid())
  userId               String
  submissionId         String
  sourceCode           String
  language             String
  problemId            String
  problemTitle         String?
  overallRating        String?
  strengths            String?
  improvements         String?
  complexityScore      Int?
  bugs                 String?
  summary              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  influencedPlanUpdate Boolean  @default(false)
  userRel              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, submissionId])
  @@index([userId, createdAt])
  @@index([problemId])
}

model LearningPlan {
  id                     String         @id @default(cuid())
  userId                 String
  targetRating           Int
  currentRating          Int?
  weeklyMilestones       String
  studyAdvice            String?
  progress               Float          @default(0)
  completedTasks         String         @default("[]")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  currentZone            String?
  lastUpdatedFromReview  DateTime?
  reviewCount            Int            @default(0)
  targetZone             String
  recommendationCriteria String         @default("{}")
  userRel                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks                  LearningTask[]

  @@index([userId])
}

model LearningTask {
  id          String       @id @default(cuid())
  planId      String
  userId      String
  title       String
  description String?
  taskType    String
  dueDate     DateTime?
  status      String       @default("pending")
  problemId   String?
  resources   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  plan        LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userRel     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId, dueDate])
  @@index([userId, status])
}

model UecNotice {
  id         String   @id @default(cuid())
  userId     String
  title      String
  date       String?
  publisher  String?
  category   String?
  href       String?
  rawText    String
  unread     Boolean  @default(false)
  detailHtml String?
  detailText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userRel    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, unread])
}

model UecScheduleEntry {
  id        String   @id @default(cuid())
  userId    String
  dateLabel String
  weekday   String
  time      String?
  title     String
  rawText   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userRel   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateLabel])
}

model UecTimetableEntry {
  id         String   @id @default(cuid())
  userId     String
  day        String
  period     String
  title      String
  courseCode String?
  room       String?
  rawText    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userRel    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day, period])
}

model UecSyncLog {
  id           String   @id @default(cuid())
  userId       String
  dataType     String
  status       String
  itemCount    Int?
  errorMessage String?
  syncDuration Int?
  createdAt    DateTime @default(now())
  userRel      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TimerSession {
  id                  String    @id @default(cuid())
  userId              String
  title               String?
  durationMinutes     Int
  actualDurationSeconds Int?
  category            String    @default("custom")
  completed           Boolean   @default(false)
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  userRel             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, category])
}

model Apg4bChapter {
  id          String   @id @default(cuid())
  chapterId   String   @unique
  title       String
  section     String
  order       Int
  description String?
  problemId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons      Apg4bLesson[]
  userProgress Apg4bUserProgress[]
}

model Apg4bLesson {
  id          String   @id @default(cuid())
  chapterId   String
  lessonId    String
  title       String
  problemId   String   @unique
  order       Int
  difficulty  Int?
  concepts    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter      Apg4bChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  userProgress Apg4bUserProgress[]

  @@index([chapterId])
}

model Apg4bUserProgress {
  id          String    @id @default(cuid())
  userId      String
  chapterId   String?
  lessonId    String?
  status      String    @default("not_started")
  startedAt   DateTime?
  completedAt DateTime?
  memo        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chapter Apg4bChapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lesson  Apg4bLesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userRel User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@unique([userId, lessonId])
  @@index([userId, status])
}
