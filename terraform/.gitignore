# ===================================================================
# Terraform .gitignore
# ===================================================================

# Terraform状態ファイル
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# 変数ファイル（シークレット含む）
terraform.tfvars
*.tfvars
!terraform.tfvars.example

# Terraform lockファイル
.terraform.lock.hcl

# Terraformモジュールキャッシュ
.terraform/

# プランファイル
*.tfplan
*.plan

# OSファイル
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
